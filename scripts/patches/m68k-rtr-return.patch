diff --git a/profiles/genesis/code_generator.c b/profiles/genesis/code_generator.c
index 86f6078..67d0836 100644
--- a/profiles/genesis/code_generator.c
+++ b/profiles/genesis/code_generator.c
@@ -2427,13 +2427,16 @@ static void emit_instr(FILE *f, const GenesisRom *rom,
     /* ------------------------------------------------------------------ */
     case MN_RTR:
         /* Pop CCR (low byte of pushed word) then PC, like RTE but only
-         * the user-visible CCR bits get restored. Mirrors the RTE
-         * propagation idiom so unwind reaches the original caller. */
+         * the user-visible CCR bits get restored. Unlike RTE this can be
+         * a subroutine return (e.g. a PHP/PLP-style CCR wrapper). The guest
+         * return PC is already popped here, so the generated JSR caller
+         * observes slot_sp+4 and resumes after the call. Propagating
+         * g_rte_pending would incorrectly unwind that caller as well. */
         fprintf(f, "  { uint16_t _ccrw = (uint16_t)m68k_read16(g_cpu.A[7]); g_cpu.A[7] += 2;\n");
         fprintf(f, "    g_cpu.SR = (uint16_t)((g_cpu.SR & 0xFF00u) | (_ccrw & 0x00FFu)); }\n");
         fprintf(f, "  g_cpu.PC = m68k_read32(g_cpu.A[7]); g_cpu.A[7] += 4;\n");
         emit_cycle_accounting(f, "  ", estimate_cycles(instr));
-        fprintf(f, "  g_rte_pending = 1; return; /* RTR */\n");
+        fprintf(f, "  return; /* RTR: PC already popped; caller resumes */\n");
         *skip_until_label = true;
         break;
 
