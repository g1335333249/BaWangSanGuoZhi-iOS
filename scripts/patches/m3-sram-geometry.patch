+/* Cartridge-save diagnostics are opt-in and bounded so a normal run pays
+ * only a cached branch. Include writes rejected by the overlay gate. */
+static void trace_sram_write(const GenesisBus *b, uint32_t addr, uint32_t value,
+                             unsigned width)
+{
+    static int enabled = -1;
+    static uint64_t start_frame;
+    static unsigned count;
+    if (enabled < 0) {
+        enabled = getenv("GENESIS_M3_SRAM_TRACE") != NULL;
+        const char *start = getenv("GENESIS_M3_SRAM_TRACE_START_FRAME");
+        if (start) start_frame = strtoull(start, NULL, 10);
+    }
+    extern uint64_t g_frame_count;
+    if (g_frame_count < start_frame) return;
+    if (!enabled || count >= 64) return;
+    if (addr != 0xA130F0u && addr != 0xA130F1u &&
+        (addr < 0x200000u || addr > 0x20FFFFu)) return;
+    fprintf(stderr, "[M3SRAM] frame=%llu addr=$%06X width=%u value=$%08X "
+            "present=%u enabled=%u\n", (unsigned long long)g_frame_count,
+            addr, width, value, b->sram_present, b->sram_enabled);
+    ++count;
+}
+
 /* Recompiled 68K memory. */
 extern uint8_t g_rom[0x400000];
 extern uint8_t g_ram[0x010000];
@@ -148,11 +174,14 @@ void gbus_sram_setup(GenesisBus *b)
         uint32_t end   = ((uint32_t)g_rom[0x1B8] << 24) | ((uint32_t)g_rom[0x1B9] << 16)
                        | ((uint32_t)g_rom[0x1BA] << 8)  |  (uint32_t)g_rom[0x1BB];
         uint32_t base  = start & ~1u;
+        uint32_t rom_end = ((uint32_t)g_rom[0x1A4] << 24) | ((uint32_t)g_rom[0x1A5] << 16)
+                         | ((uint32_t)g_rom[0x1A6] << 8) | (uint32_t)g_rom[0x1A7];
         if (end > base && (end - base + 1u) <= sizeof(b->sram)) {
             b->sram_present = 1;
             b->sram_base    = base;
             b->sram_end     = end;
             b->sram_size    = end - base + 1u;
+            b->sram_always_visible = base > rom_end;
         }
     }
 }
